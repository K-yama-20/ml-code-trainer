# Local mode: SQLite + secure opaque guest cookie, no third-party account needed.
APP_ENV=development
DATABASE_URL=sqlite:///./trainer.db
WEB_ORIGIN=http://127.0.0.1:5173
# Production requires Supabase Auth and PostgreSQL.
SUPABASE_URL=
SUPABASE_AUDIENCE=authenticated
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# disabled | modal. Run the separate worker after enabling Modal.
EXECUTION_PROVIDER=disabled
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Browser runtime is pinned to the public Pyodide 0.29.3 CDN in python.ts.
# Never pass auth or secrets to the execution iframe/worker.
